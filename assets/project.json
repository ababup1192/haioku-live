  "editor": {
    "resources": [
      {
        "id": "story",
        "pattern": "assets/novel.story.json",
        "title": "画面の言葉（タイトル画面・ボタン・セーブ）と主人公の名前",
        "role": "material",
        "schema": "assets/story.schema.json"
      },
      {
        "id": "backdrops",
        "pattern": "assets/novel.backdrops.json",
        "title": "背景の場所（カメラの映像）・怪異の重ね絵・映像の質感",
        "role": "material",
        "schema": "assets/backdrops.schema.json"
      },
      {
        "id": "theme",
        "pattern": "assets/novel.theme.json",
        "title": "字と配信の表示の色",
        "role": "material",
        "schema": "assets/theme.schema.json"
      },
      {
        "id": "credits",
        "pattern": "assets/novel.credits.json",
        "title": "クレジット（画像・フォント・音の出典）",
        "role": "material",
        "schema": "assets/credits.schema.json"
      },
      {
        "id": "kind",
        "pattern": "assets/novel.kind.json",
        "title": "手触り（字の大きさ・オート・スキップ・コメントの間・揺れ・演出の長さ）",
        "role": "tuning",
        "schema": "assets/kind.schema.json"
      },
      {
        "id": "keys",
        "pattern": "assets/novel.keys.json",
        "title": "操作（キーの割り当て）",
        "role": "tuning",
        "schema": "assets/keys.schema.json"
      },
      {
        "id": "portrait",
        "pattern": "assets/novel.portrait.json",
        "title": "縦の画面の字とボタンの大きさ",
        "role": "tuning",
        "schema": "assets/portrait.schema.json"
      },
      {
        "id": "mixer",
        "pattern": "assets/novel.mixer.json",
        "title": "音の通り道（環境音・BGM・効果音のバス）",
        "role": "tuning"
      },
      {
        "id": "project",
        "pattern": "project.json",
        "schema": "project.schema.json",
        "title": "ゲームの題・画面",
        "role": "tuning"
      },
      {
        "id": "walks",
        "pattern": "assets/walk/walks.json",
        "title": "3D の場面の切り替え（カメラの道筋・音・揺れ。Blender から書き出した表）",
        "role": "material"
      }
    ]
  },
  "web": {
    "keysDoc": "assets/novel.keys.json",
    "touchGestures": {
      "longPress": "back",
      "swipeLeft": "rollback"
    },
    "orientation": "portrait",
    "portraitDesign": {
      "width": 540,
      "minHeight": 960
    }
  },
  "// sounds": "音の名前 → ファイルの対応はここ 1 か所（名前 = ファイル名の茎）。拡張子を替える時は make sfx-ext EXT=ogg（Makefile）。鳴り続ける音（amb_・bgm_・心音と呼吸）は looping。"
}
