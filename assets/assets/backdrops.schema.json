{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "背景の場所・怪異の重ね絵・カメラの質感（novel.backdrops.json）",
  "description": "シナリオの <<bg 場所>> と <<apparition 重ね絵>> の名前はここの鍵。背景はスマホのカメラに映る夜の廃屋の画像で、ざらつき・四隅の落ち・ライトの丸い光の揺れはシェーダー（src/Backdrop.flix）が付ける。",
  "type": "object",
  "required": [
    "version",
    "places"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "note": {
      "type": "string"
    },
    "places": {
      "type": "object",
      "description": "場所の名前 → 場所",
      "additionalProperties": {
        "type": "object",
        "required": [
          "texture"
        ],
        "properties": {
          "texture": {
            "type": "string",
            "description": "project.json の textures の名前（空なら何も映らない真っ暗な画面）"
          },
          "label": {
            "type": "string",
            "description": "セーブ画面に出す場所の名前"
          },
          "exposure": {
            "type": "number",
            "minimum": 0,
            "maximum": 4,
            "description": "その画像の明るさの倍率（1 = そのまま。暗すぎる画像を持ち上げる）"
          }
        }
      }
    },
    "overlays": {
      "type": "object",
      "description": "重ね絵（怪異）の名前 → 重ね絵",
      "additionalProperties": {
        "type": "object",
        "required": [
          "texture"
        ],
        "properties": {
          "texture": {
            "type": "string",
            "description": "project.json の textures の名前"
          },
          "x": {
            "type": "number",
            "description": "背景の絵の中の左端（背景の幅に対する割合）"
          },
          "y": {
            "type": "number",
            "description": "背景の絵の中の上端（背景の高さに対する割合）"
          },
          "h": {
            "type": "number",
            "minimum": 0,
            "description": "高さ（背景の高さに対する割合。幅は絵の縦横の比のまま）"
          },
          "pixelWidth": {
            "type": "integer",
            "minimum": 1,
            "description": "絵の画素の幅（PNG を差し替えたら直す）"
          },
          "pixelHeight": {
            "type": "integer",
            "minimum": 1,
            "description": "絵の画素の高さ（PNG を差し替えたら直す）"
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "いちばん濃く映る時の不透明さ"
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "description": "カメラの映像の質感",
      "properties": {
        "grain": {
          "type": "number",
          "minimum": 0,
          "description": "センサーのざらつきの強さ"
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "四隅を落とす強さ"
        },
        "light": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "ライトの丸い光の外を沈める強さ（0 = 沈めない）"
        },
        "lightRadius": {
          "type": "number",
          "minimum": 0,
          "description": "丸い光の半径（画面の高さに対する割合）"
        },
        "swayPx": {
          "type": "number",
          "minimum": 0,
          "description": "手持ちの揺れの幅（design px）"
        },
        "lightSway": {
          "type": "number",
          "minimum": 0,
          "description": "丸い光が揺れる幅（画面の高さに対する割合）"
        },
        "bleed": {
          "type": "number",
          "minimum": 0,
          "description": "背景を画面より大きく敷く量（design px。揺れても端が覗かない）"
        }
      }
    },
    "switchSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "<<bg>> で秒を書かない時の切り替えの長さ（秒）"
    },
    "blood": {
      "type": "object",
      "description": "<<blood>> の絵（project.json の textures の名前）",
      "properties": {
        "color": {
          "type": "string",
          "description": "垂れの色の絵"
        },
        "key": {
          "type": "string",
          "description": "R = 垂れの濃さ・G = 垂れが届く時刻（黒 = 早い）の絵"
        }
      }
    }
  }
}
