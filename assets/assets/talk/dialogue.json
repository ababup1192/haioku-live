          ]
        },
        {
          "kind": "line",
          "line": 107,
          "text": "台所は、居間より少しだけ生活の跡が残っていた。"
        },
        {
          "kind": "line",
          "line": 108,
          "text": "流しに、割れた茶碗。冷蔵庫の扉は半開きで、中は空だった。"
        },
        {
          "kind": "command",
          "line": 109,
          "name": "se",
          "args": [
            "se_timer"
          ]
        },
        {
          "kind": "line",
          "line": 110,
          "text": "ボロっちいタイマーが鳴っていた。"
        },
        {
          "kind": "line",
          "line": 111,
          "text": "これが鳴っていたのか。"
        },
        {
          "kind": "line",
          "line": 112,
          "speaker": "hero",
          "text": "あー驚いて損した"
        },
        {
          "kind": "line",
          "line": 113,
          "text": "恐らく、古いタイマーが誤動作したんだろう。"
        },
        {
          "kind": "command",
          "line": 114,
          "name": "se",
          "args": [
            "se_creak"
          ]
        },
        {
          "kind": "command",
