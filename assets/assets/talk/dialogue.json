          "text": "ごくん"
        },
        {
          "kind": "line",
          "line": 99,
          "text": "思わず生唾を飲み込む。"
        },
        {
          "kind": "line",
          "line": 100,
          "text": "奥の部屋から聞こえた。"
        },
        {
          "kind": "command",
          "line": 101,
          "name": "comment",
          "args": [
            "sasaki＠",
            "いけいけいけいけいけ"
          ]
        },
        {
          "kind": "command",
          "line": 102,
