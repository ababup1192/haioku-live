            "きた"
          ]
        },
        {
          "kind": "command",
          "line": 37,
          "name": "comment",
          "args": [
            "ろん",
            "こんばんはー"
          ]
        },
        {
          "kind": "command",
          "line": 38,
          "name": "comment",
          "args": [
            "sasaki＠",
            "こんばんは"
          ]
        },
        {
          "kind": "line",
          "line": 39,
          "speaker": "hero",
          "text": "お、3人も来てくれてる。ありがとうございます"
        },
        {
          "kind": "line",
          "line": 40,
          "text": "正直、少ない。"
        },
        {
          "kind": "line",
          "line": 41,
          "text": "でもいつもと比べたら多い方だ。"
        },
        {
          "kind": "command",
          "line": 42,
          "name": "se",
          "args": [
            "se_cloth"
          ]
        },
        {
          "kind": "command",
          "line": 43,
          "name": "comment",
          "args": [
            "ポi",
            "同接3ｗｗ"
          ]
        },
        {
          "kind": "command",
          "line": 44,
          "name": "comment",
          "args": [
            "ろん",
            "伸び悩み配信者、今日も元気"
          ]
        },
        {
          "kind": "line",
          "line": 45,
          "speaker": "hero",
          "text": "ははは、これから人気出る予定ですから"
        },
        {
          "kind": "line",
          "line": 46,
          "speaker": "hero",
          "text": "それより、ここ、知ってます？　何年も前に住人がいなくなって、それから誰も近づかないって噂の家です"
        },
        {
          "kind": "line",
          "line": 47,
          "speaker": "hero",
          "text": "まあ、噂は噂。今夜は俺が、奥まで全部お見せします"
        },
        {
          "kind": "line",
          "line": 48,
          "text": "強がってはみたものの、門の前で、足は少しだけ止まっていた。"
        },
        {
          "kind": "line",
          "line": 49,
          "text": "行くなら、今だ。視聴者が飽きないように。"
        },
        {
          "kind": "line",
          "line": 50,
          "speaker": "hero",
          "text": "じゃあ、入りまーす"
        },
