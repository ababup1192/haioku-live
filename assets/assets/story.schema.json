{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "画面の言葉（novel.story.json）",
  "description": "シナリオの外で画面に出す言葉と、主人公の名前（labels の heroName。台本の ×××× に入る）。文章・分岐・結末はシナリオ assets/talk/haioku.yarn。",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "description": "Doc の形の版。いまは 1"
    },
    "note": {
      "type": "string",
      "description": "人間と AI のためのメモ（ゲームは読まない）"
    },
    "title": {
      "type": "string",
      "description": "タイトル画面の題"
    },
    "subtitle": {
      "type": "string",
      "description": "タイトル画面の題の下の 1 行"
    },
    "hint": {
      "type": "string",
      "description": "タイトル画面の下の操作の案内"
    },
    "titlePlace": {
      "type": "string",
      "description": "タイトル画面の背景の場所（novel.backdrops.json の places の鍵）"
    },
    "titleAmbience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "タイトル画面で鳴り続ける音（project.json の sounds の名前。空なら鳴らさない）"
    },
    "labels": {
      "type": "object",
      "description": "言葉の鍵（src/StoryDoc.flix の Label）→ 言葉。無い鍵は既定の言葉で出る",
      "properties": {
        "newGame": {
          "type": "string"
        },
        "continue": {
          "type": "string"
        },
        "loadGame": {
          "type": "string"
        },
        "settings": {
          "type": "string"
        },
        "credits": {
          "type": "string"
        },
        "quit": {
          "type": "string"
        },
        "heroName": {
          "type": "string",
          "description": "主人公の名前（台本の ×××× に入る）"
        },
        "rollback": {
          "type": "string"
        },
        "log": {
          "type": "string"
        },
        "auto": {
          "type": "string"
        },
        "skip": {
          "type": "string"
        },
        "quickSave": {
          "type": "string"
        },
        "quickLoad": {
          "type": "string"
        },
        "save": {
          "type": "string"
        },
        "load": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "hide": {
          "type": "string"
        },
        "toTitle": {
          "type": "string"
        },
        "menu": {
          "type": "string"
        },
        "saveTitle": {
          "type": "string"
        },
        "loadTitle": {
          "type": "string"
        },
        "logTitle": {
          "type": "string"
        },
        "settingsTitle": {
          "type": "string"
        },
        "back": {
          "type": "string"
        },
        "tabAuto": {
          "type": "string"
        },
        "tabQuick": {
          "type": "string"
        },
        "emptySlot": {
          "type": "string"
        },
        "newBadge": {
          "type": "string"
        },
        "slotsHint": {
          "type": "string"
        },
        "logHint": {
          "type": "string"
        },
        "groupText": {
          "type": "string"
        },
        "groupSound": {
          "type": "string"
        },
        "textSpeed": {
          "type": "string"
        },
        "autoWait": {
          "type": "string"
        },
        "skipScope": {
          "type": "string"
        },
        "skipReadOnly": {
          "type": "string"
        },
        "skipEverything": {
          "type": "string"
        },
        "afterChoice": {
          "type": "string"
        },
        "stopSkip": {
          "type": "string"
        },
        "keepSkip": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "windowMode": {
          "type": "string"
        },
        "fullscreenMode": {
          "type": "string"
        },
        "masterVolume": {
          "type": "string"
        },
        "ambienceVolume": {
          "type": "string"
        },
        "musicVolume": {
          "type": "string",
          "description": "BGM の音量の行の言葉"
        },
        "seVolume": {
          "type": "string"
        },
        "windowAlpha": {
          "type": "string"
        },
        "reset": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        },
        "yes": {
          "type": "string"
        },
        "no": {
          "type": "string"
        },
        "askOverwrite": {
          "type": "string"
        },
        "askDelete": {
          "type": "string"
        },
        "askLoad": {
          "type": "string"
        },
        "askJump": {
          "type": "string"
        },
        "askToTitle": {
          "type": "string"
        },
        "askQuit": {
          "type": "string"
        },
        "askReset": {
          "type": "string"
        },
        "lostNote": {
          "type": "string"
        },
        "saved": {
          "type": "string"
        },
        "quickSaved": {
          "type": "string"
        },
        "loaded": {
          "type": "string"
        },
        "deleted": {
          "type": "string"
        },
        "resetDone": {
          "type": "string"
        },
        "noSave": {
          "type": "string"
        },
        "noQuickSave": {
          "type": "string"
        },
        "noRollback": {
          "type": "string"
        },
        "liveBadge": {
          "type": "string",
          "description": "配信の表示の赤い札の字（左上）"
        },
        "noService": {
          "type": "string",
          "description": "状態バーの圏外の字"
        }
      },
      "additionalProperties": false
    }
  }
}
