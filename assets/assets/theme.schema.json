{
  "//": "novel.theme.json の形の宣言（Studio の sections 方言）。字・下の帯・配信の表示・コメントの色。背景の色はカメラの映像そのもので、ここには置かない。",
  "version": 1,
  "sections": {
    "ink": {
      "kind": "field",
      "type": "color",
      "label": "本文の字",
      "order": 1,
      "required": true
    },
    "inkSeen": {
      "kind": "field",
      "type": "color",
      "label": "既読の行の字（スキップで飛ばせる行）",
      "order": 2,
      "required": true
    },
    "accent": {
      "kind": "field",
      "type": "color",
      "label": "選んでいる物・オートとスキップの点灯（LED の白い光）",
      "order": 3,
      "required": true
    },
    "panel": {
      "kind": "field",
      "type": "color",
      "label": "下の帯・画面の地（カメラの暗部の黒〜青灰）",
      "order": 4,
      "required": true
    },
    "live": {
      "kind": "field",
      "type": "color",
      "label": "配信表示の赤（● LIVE と最後の赤いコメントだけ）",
      "order": 5,
      "required": true
    },
    "chatText": {
      "kind": "field",
      "type": "color",
      "label": "コメントの本文",
      "order": 7,
      "required": true
    },
    "chatNames": {
      "kind": "catalog",
      "label": "コメントの名前 → 名前の色（鍵 = コメントの名前・値は #rrggbb の色の文字列）",
      "order": 8,
      "value": {
        "type": "color",
        "label": "名前の色"
      }
    },
    "chatName": {
      "kind": "field",
      "type": "color",
      "label": "上の表に無い名前の色",
      "order": 9,
      "required": true
    }
  }
}
