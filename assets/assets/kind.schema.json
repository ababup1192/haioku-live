{
  "//": "novel.kind.json の形の宣言（Studio の sections 方言）。手触りの数（字の大きさ・オートとスキップの間・コメントの間・BGM の音量・演出の長さと揺れ）の初期値だけ Doc に置き、規則はコード側。既定は src/KindDoc.flix の defaults() が正。",
  "version": 1,
  "sections": {
    "bodySize": {
      "kind": "field",
      "type": "float",
      "label": "本文の字の大きさ（px）",
      "order": 1,
      "min": 12,
      "max": 40,
      "default": 25.0
    },
    "rubySize": {
      "kind": "field",
      "type": "float",
      "label": "ルビの字の大きさ（px）",
      "order": 2,
      "min": 6,
      "max": 20,
      "default": 12.0
    },
    "lineGap": {
      "kind": "field",
      "type": "float",
      "label": "行の間（px。ルビが入るので rubySize 以上）",
      "order": 3,
      "min": 0,
      "max": 40,
      "default": 14.0
    },
    "cps": {
      "kind": "field",
      "type": "float",
      "label": "文字の速さの既定（1 秒の字数。設定の画面で変えた値は saves/novel.json）",
      "order": 4,
      "min": 5,
      "max": 200,
      "default": 30.0
    },
    "autoWait": {
      "kind": "field",
      "type": "float",
      "label": "オートの待ちの既定（秒）",
      "order": 5,
      "min": 0,
      "max": 10,
      "default": 1.4
    },
    "masterVolume": {
      "kind": "field",
      "type": "float",
      "label": "全体の音量の既定（0〜1。環境音と効果音に掛ける）",
      "order": 6,
      "min": 0,
      "max": 1,
      "default": 1.0
    },
    "ambienceVolume": {
      "kind": "field",
      "type": "float",
      "label": "環境音の音量の既定（0〜1）",
      "order": 7,
      "min": 0,
      "max": 1,
      "default": 0.8
    },
    "musicVolume": {
      "kind": "field",
      "type": "float",
      "label": "BGM の音量の既定（0〜1）",
      "min": 0,
      "max": 1,
      "default": 0.7,
      "order": 8
    },
    "seVolume": {
      "kind": "field",
      "type": "float",
      "label": "効果音の音量の既定（0〜1）",
      "order": 9,
      "min": 0,
      "max": 1,
      "default": 0.9
    },
    "windowAlpha": {
      "kind": "field",
      "type": "float",
      "label": "下の帯の濃さの既定（0〜1）",
      "order": 10,
      "min": 0,
      "max": 1,
      "default": 0.8
    },
    "autoPerChar": {
      "kind": "field",
      "type": "float",
      "label": "オートの待ちに足す 1 字あたりの秒",
      "order": 11,
      "min": 0,
      "max": 0.5,
      "default": 0.05
    },
    "skipInterval": {
      "kind": "field",
      "type": "float",
      "label": "スキップで 1 行を出す間（秒）",
      "order": 12,
      "min": 0,
      "max": 1,
      "default": 0.06
    },
    "logMax": {
      "kind": "field",
      "type": "int",
      "label": "ログに残す行の数",
      "order": 13,
      "min": 10,
      "max": 1000,
      "default": 200
    },
    "commentInterval": {
      "kind": "field",
      "type": "float",
      "label": "続けて流れるコメントの間（秒）",
      "min": 0.05,
      "max": 5,
      "default": 0.65,
      "order": 14
    },
    "chatMax": {
      "kind": "field",
      "type": "int",
      "label": "コメント欄に残す件数",
      "min": 1,
      "max": 30,
      "default": 7,
      "order": 15
    },
    "chatFadeIn": {
      "kind": "field",
      "type": "float",
      "label": "コメントが現れてから濃くなるまでの秒",
      "min": 0,
      "max": 2,
      "default": 0.25,
      "order": 16
    },
    "bgmVolume": {
      "kind": "field",
      "type": "float",
      "label": "<<bgm 名>> の BGM の音量（0〜1）",
      "min": 0,
      "max": 1,
      "default": 0.6,
      "order": 17
    },
    "bgmRaisedVolume": {
      "kind": "field",
      "type": "float",
