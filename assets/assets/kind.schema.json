      "max": 1,
      "default": 0.85,
      "order": 18
    },
    "apparitionSeconds": {
      "kind": "field",
      "type": "float",
      "label": "怪異が映る長さ（秒）",
      "min": 0.1,
      "max": 10,
      "default": 1.1,
      "order": 19
    },
    "bloodSeconds": {
      "kind": "field",
      "type": "float",
      "label": "血が垂れてから消えるまでの長さ（秒）",
      "min": 0.5,
      "max": 20,
      "default": 6.5,
      "order": 20
    },
    "vibrateSeconds": {
      "kind": "field",
      "type": "float",
      "label": "振動の長さ（秒）",
      "min": 0.05,
      "max": 5,
      "default": 0.5,
      "order": 21
    },
    "vibratePx": {
      "kind": "field",
      "type": "float",
      "label": "振動の揺れ幅（px）",
      "min": 0,
      "max": 30,
      "default": 3.0,
      "order": 22
    },
    "crashSeconds": {
      "kind": "field",
      "type": "float",
      "label": "最後の激しい揺れの長さ（秒）",
      "min": 0.1,
      "max": 10,
      "default": 1.8,
      "order": 23
    },
    "crashPx": {
      "kind": "field",
      "type": "float",
      "label": "最後の激しい揺れの揺れ幅（px）",
      "min": 0,
      "max": 100,
      "default": 30.0,
      "order": 24
    },
    "phoneClockStart": {
      "kind": "field",
      "type": "float",
      "label": "配信を始めた時の状態バーの時刻（0 時からの分。1421 = 23:41）",
      "order": 24.5,
      "min": 0,
      "max": 1439,
      "default": 1421.0
    },
    "creditsSpeed": {
      "kind": "field",
      "type": "float",
      "label": "クレジットが流れる速さ（px/秒）",
      "order": 25,
      "min": 5,
      "max": 200,
      "default": 40.0
    },
    "toastSeconds": {
      "kind": "field",
      "type": "float",
      "label": "知らせを出す秒",
      "order": 26,
      "min": 0.2,
      "max": 10,
      "default": 1.6
    },
    "cpsSlider": {
      "kind": "record",
      "label": "文字の速さのスライダー（字/秒）",
      "group": "設定の画面のスライダー",
      "order": 27,
      "fields": {
        "min": {
          "type": "float",
          "label": "下限",
          "order": 1,
          "default": 10.0
